{
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "name": "Paper Plane Run",
  "short_name": "Paper Plane",
  "description": "Soar through a paper city. Dodge birds & scissors, grab power-ups, ride the wind.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#c8dff5",
  "theme_color": "#c8dff5",
  "categories": ["games", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Classic Flight",
      "short_name": "Classic",
      "description": "Endless paper-sky run",
      "url": "/?mode=classic",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Daily Route",
      "short_name": "Daily",
      "description": "Today's seeded challenge",
      "url": "/?mode=daily",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Living Journey",
      "short_name": "Journey",
      "description": "Story routes across the paper skies",
      "url": "/?mode=journey",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
